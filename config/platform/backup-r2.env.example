# This file is a template. Install the real file at /srv/platform/secrets/backup-r2.env (mode 0600).
# Keep every value secret except AWS_DEFAULT_REGION. Do not commit the real file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=
RESTIC_REPOSITORY=
# Set this to a root-owned file outside Git, not an inline password.
RESTIC_PASSWORD_FILE=/srv/platform/secrets/backup-restic-password
